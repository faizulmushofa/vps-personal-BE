# =========================================================================
# Configuration Env for VPS Personal Backend (Spring Boot)
# Copy file ini menjadi `.env` di server production Anda
# =========================================================================

# Port yang diekspos ke host VPS
PORT=8090

# Database PostgreSQL R2DBC URL
DATABASE_URL=r2dbc:postgresql://username:password@hostname:port/dbname?sslMode=require

# JWT Sign Secret Key (Minimal 32 bytes/karakter acak)
SECRET_KEY=your_jwt_signing_secret_key_here

# gRPC Storage Node Config (Jalur Local Docker Network)
STORAGE_NODE_URL=static://storage-node-grpc:9090
GRPC_CLIENT_NEGOTIATION_TYPE=plaintext
GRPC_CLIENT_SECURE=false
SERVICE_TOKEN=your_grpc_auth_token_here

# LLM & AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPEN_ROUTER_API_KEY=your_open_router_api_key_here
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Google OAuth2 Credentials
GOOGLE_GLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Brevo (Sendinblue) Email Provider
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=info@horizoncloud.my.id
BREVO_SENDER_NAME="HORIZON VPS Cloud"

# Dropbox Cloud Storage integration
DROP_BOX_KEY=your_dropbox_app_key_here
DROP_BOX_SECRET_KEY=your_dropbox_app_secret_here
DROP_BOX_ACCESS_TOKEN=your_dropbox_access_token_here

# Frontend Application URL
FRONTEND_URL=https://www.horizoncloud.my.id/

# Seeder Admin & User Default Passwords
APP_SEED_ADMIN_PASSWORD=your_admin_seed_password_here
APP_SEED_USER_PASSWORD=your_user_seed_password_here

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/v1
MIDTRANS_API_URL=https://api.midtrans.com
